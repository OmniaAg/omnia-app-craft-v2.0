{
  "name": "omnia-app-craft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts vite.config.ts vitest.config.ts vitest.connectivity.config.ts",
    "test": "vitest run",
    "preview": "vite preview --port 53170 --strictPort",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test:pwa": "node scripts/test-pwa-integration.mjs",
    "test:push": "node scripts/test-push-integration.mjs",
    "phase14:prepare": "node scripts/prepare-phase14-local.mjs",
    "functions:serve:phase14:test": "supabase functions serve --env-file supabase/.env.phase14-test.local",
    "push:worker:once": "node scripts/push-worker.mjs",
    "verify:phase14": "node scripts/verify-phase14.mjs",
    "verify:phase14:regressions": "node scripts/verify-phase14.mjs --regressions",
    "db:start": "node scripts/start-local-supabase.mjs",
    "db:stop": "supabase stop --project-id omnia-craft",
    "db:status": "node scripts/show-local-supabase-status.mjs",
    "db:reset": "node scripts/reset-local-supabase.mjs",
    "db:test": "supabase test db supabase/tests/database --local",
    "db:lint": "supabase db lint --local --schema public,app_private --fail-on error",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "functions:serve": "supabase functions serve invite-user",
    "functions:serve:phase13": "supabase functions serve --env-file supabase/.env.local",
    "functions:serve:phase13:test": "supabase functions serve --env-file supabase/.env.phase13-test.local",
    "phase13:prepare": "node scripts/prepare-phase13-local.mjs",
    "worker:once": "node scripts/phase13-worker.mjs",
    "worker:watch": "node scripts/phase13-worker.mjs --watch",
    "test:automations": "node scripts/test-phase13-integration.mjs automations",
    "test:integrations": "node scripts/test-phase13-integration.mjs integrations",
    "test:ai": "node scripts/test-phase13-integration.mjs ai",
    "verify:phase13": "node scripts/verify-phase13.mjs",
    "verify:phase13:regressions": "node scripts/verify-phase13.mjs --regressions",
    "webhook:receiver": "node scripts/phase13-webhook-receiver.mjs",
    "test:connectivity": "node scripts/wait-for-postgrest.mjs && vitest run --config vitest.connectivity.config.ts",
    "test:auth": "node scripts/test-auth-integration.mjs",
    "test:crm": "node scripts/test-crm-integration.mjs",
    "test:work": "node scripts/test-work-integration.mjs",
    "test:dashboard": "node scripts/test-dashboard-integration.mjs",
    "test:editorial": "node scripts/test-editorial-integration.mjs",
    "test:deliverables": "node scripts/test-deliverables-integration.mjs",
    "test:files": "node scripts/test-files-integration.mjs",
    "test:portal": "node scripts/test-portal-integration.mjs",
    "test:messaging": "node scripts/test-messaging-integration.mjs",
    "test:billing": "node scripts/test-billing-integration.mjs",
    "test:analytics": "node scripts/test-analytics-integration.mjs",
    "db:files:diagnose": "node scripts/diagnose-file-storage.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "^5.102.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "2.2.4",
    "react-hook-form": "7.86.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.63.0",
    "supabase": "2.115.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
