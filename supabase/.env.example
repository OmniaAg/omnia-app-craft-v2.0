# Local server only. Copy to supabase/.env.local; never use VITE_ for these.
APP_URL=http://localhost:53170
APP_ALLOWED_ORIGINS=http://localhost:53170,http://127.0.0.1:53170
AI_PROVIDER=local_deterministic
# Base64 of 32 cryptographically random bytes (AES-256-GCM).
INTEGRATION_ENCRYPTION_KEY=
AUTOMATION_WORKER_TOKEN=
# Exact trusted origins, controlled DNS, HTTPS. No redirects or URL credentials.
WEBHOOK_ALLOWED_ORIGINS=
# Only for the deterministic loopback/host.docker.internal HTTP test receiver.
PHASE13_ALLOW_LOCAL_HTTP=false

# Phase 14 Web Push. Private key, subject and worker token are SERVER ONLY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.invalid
PUSH_WORKER_TOKEN=
PUSH_SENDER=web_push
PHASE14_LOCAL_TEST_ONLY=false
